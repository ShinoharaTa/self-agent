{
  "name": "self-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=${HOME}/.config/self-agent/env src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "test:integration": "node --env-file-if-exists=${HOME}/.config/self-agent/env --test 'test/integration/*.test.ts'",
    "measure": "node --env-file-if-exists=${HOME}/.config/self-agent/env scripts/measure-turn.ts",
    "devlog": "node --env-file-if-exists=${HOME}/.config/self-agent/env scripts/devlog.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "discord.js": "14.27.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
